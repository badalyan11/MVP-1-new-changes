{
  // Deploys the built app (dist/) as static assets plus a small Worker that
  // handles /api/* (the optional AI writing help). Every other URL is served
  // from dist/, with single-page-app fallback so routes like /journal/123 work on refresh.
  "name": "1st-mvp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
